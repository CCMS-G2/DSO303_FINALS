# Copied to .env on first run (see scripts/common.sh).
# Local development values only - do not reuse these anywhere else.

# Signs and verifies login tokens. Auth and Complaint services refuse to start without it.
JWT_SECRET=dev-only-change-me

# Host port for the local Postgres container. Change it in your own .env only
# if 5432 is already in use on your machine (e.g. a system PostgreSQL).
# POSTGRES_PORT=5432
